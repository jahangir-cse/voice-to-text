@model AccountSummary
@{
    ViewData["Title"] = "Connect WhatsApp";
    var accountId = (string)ViewBag.AccountId;
}

<div class="page-header">
    <h1>📞 Connect WhatsApp — @accountId</h1>
    <a href="@Url.Action("Index", "Settings")" class="link-clear">← Back to Settings</a>
</div>

<div class="qr-card">
    <div class="qr-instructions">
        <ol>
            <li>আপনার phone-এ <strong>WhatsApp</strong> খুলুন</li>
            <li>Settings (⋮) → <strong>Linked Devices</strong> → <strong>Link a Device</strong></li>
            <li>নিচের QR code-এ phone camera ধরুন</li>
            <li>Connection ready হলে এই page automatic Settings-এ ফিরে যাবে</li>
        </ol>
    </div>

    <div id="qr-container" class="qr-container">
        @if (Model?.State == "ready")
        {
            <div class="qr-success">
                <h2>✅ Connected!</h2>
                <p>WhatsApp account <strong>@accountId</strong> is now active.</p>
            </div>
        }
        else if (!string.IsNullOrEmpty(Model?.QrPng))
        {
            <img id="qr-image" src="@Model.QrPng" alt="WhatsApp QR" />
            <p class="qr-state muted">State: <strong>@Model.State</strong></p>
        }
        else
        {
            <p class="muted">Initializing QR... please wait a few seconds</p>
            <p class="qr-state muted">State: <strong>@(Model?.State ?? "starting")</strong></p>
        }
    </div>

    <div id="qr-error" class="flash flash-err" style="display:none;"></div>
</div>

@section Scripts {
<script>
    const accountId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(accountId));
    const errBox = document.getElementById('qr-error');
    let lastQr = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.Qr ?? ""));

    function poll() {
        fetch('/Settings/WhatsAppStatusJson?id=' + encodeURIComponent(accountId))
            .then(r => r.json())
            .then(s => {
                if (!s) return;
                const stateEl = document.querySelector('.qr-state strong');
                if (stateEl) stateEl.textContent = s.state;

                if (s.state === 'ready') {
                    document.getElementById('qr-container').innerHTML =
                        '<div class="qr-success"><h2>✅ Connected!</h2><p>WhatsApp account <strong>' + accountId + '</strong> is now active. Redirecting to Settings...</p></div>';
                    setTimeout(() => { window.location.href = '/Settings'; }, 1500);
                    return;
                }

                if (s.qrPng && s.qr !== lastQr) {
                    lastQr = s.qr;
                    let container = document.getElementById('qr-container');
                    let img = document.getElementById('qr-image');
                    if (!img) {
                        container.innerHTML =
                            '<img id="qr-image" src="' + s.qrPng + '" alt="WhatsApp QR" />' +
                            '<p class="qr-state muted">State: <strong>' + s.state + '</strong></p>';
                    } else {
                        img.src = s.qrPng;
                    }
                }

                if (s.state === 'error') {
                    errBox.textContent = 'Error: ' + (s.error || 'unknown');
                    errBox.style.display = 'block';
                }
            })
            .catch(() => { /* ignore network blips */ });
    }

    setInterval(poll, 2000);
    setTimeout(poll, 500);
</script>
}
