<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CRM Demo</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <div class="topbar-inner">
            <a class="brand" asp-controller="Home" asp-action="Index">CRM Demo</a>
            <nav class="topbar-nav">
                <a asp-controller="Home" asp-action="Index">Contacts</a>
                <a asp-controller="Settings" asp-action="Index">Settings</a>
                <a asp-controller="Developer" asp-action="Index">Developer Guide</a>
            </nav>
        </div>
    </header>

    <main class="container">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container">
            <span class="muted">CRM Demo · Detection-service integration · @DateTime.UtcNow.Year</span>
        </div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
