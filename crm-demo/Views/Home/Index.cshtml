@model List<ContactRow>
@{
    ViewData["Title"] = "Contact List";
    var currentPage = (int)ViewBag.Page;
    var currentPageSize = (int)ViewBag.PageSize;
    var total = (int)ViewBag.Total;
    var query = (string)ViewBag.Query;
    var detectionHealthy = (bool)ViewBag.DetectionHealthy;
    var totalPages = (int)Math.Ceiling(total / (double)currentPageSize);

    string LocalDisplay(string number)
        => number.StartsWith("880") ? "0" + number.Substring(3) : number;
}

<div class="page-header">
    <h1>📇 Contact List</h1>
    <div class="status-row">
        @if (detectionHealthy)
        {
            <span class="badge badge-ok">● Detection API: connected</span>
        }
        else
        {
            <span class="badge badge-err">● Detection API: offline</span>
        }
        <span class="muted">Total: <strong>@total</strong> contacts</span>
    </div>
</div>

<form method="get" class="search-bar">
    <input type="text" name="q" value="@query" placeholder="Search name or number..." />
    <input type="hidden" name="pageSize" value="@currentPageSize" />
    <button type="submit">Search</button>
    @if (!string.IsNullOrEmpty(query))
    {
        <a href="?" class="link-clear">Clear</a>
    }
</form>

@{
    var flashMsg = TempData["FlashMessage"] as string;
    var flashKind = TempData["FlashKind"] as string;
}
@if (!string.IsNullOrEmpty(flashMsg))
{
    <div class="flash flash-@(flashKind ?? "info")">@flashMsg</div>
}

<div class="action-bar">
    <div class="action-bar-label">Run detection on this page (page @currentPage, @Model.Count contacts):</div>
    <form method="post" asp-controller="Home" asp-action="CheckWhatsApp" class="inline-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="page" value="@currentPage" />
        <input type="hidden" name="pageSize" value="@currentPageSize" />
        <input type="hidden" name="q" value="@query" />
        <button type="submit" class="action-btn action-wa">
            <svg viewBox="0 0 24 24" width="16" height="16"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" fill="#fff"/></svg>
            Check WhatsApp
        </button>
    </form>
    <form method="post" asp-controller="Home" asp-action="CheckTelegram" class="inline-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="page" value="@currentPage" />
        <input type="hidden" name="pageSize" value="@currentPageSize" />
        <input type="hidden" name="q" value="@query" />
        <button type="submit" class="action-btn action-tg">
            <svg viewBox="0 0 24 24" width="16" height="16"><path d="M9.78 18.65l.28-4.23 7.68-6.92c.34-.31-.07-.46-.52-.19L7.74 13.3 3.64 12c-.88-.25-.89-.86.2-1.3l15.97-6.16c.73-.33 1.43.18 1.15 1.3l-2.72 12.81c-.19.91-.74 1.13-1.5.71L12.6 16.3l-1.99 1.93c-.23.23-.42.42-.83.42z" fill="#fff"/></svg>
            Check Telegram
        </button>
    </form>
</div>

@{
    string BoolText(bool? v)
    {
        if (v == true) return "true";
        if (v == false) return "false";
        return "—";
    }
    string BoolClass(bool? v)
    {
        if (v == true) return "bool-true";
        if (v == false) return "bool-false";
        return "bool-unknown";
    }
}

<table class="contact-table">
    <thead>
        <tr>
            <th>#</th>
            <th>Name</th>
            <th>Phone</th>
            <th>isWhatsApp</th>
            <th>isTelegram</th>
            <th class="actions-col">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Model)
        {
            var c = row.Contact;
            var d = row.Detection;
            var hasWA = d != null && d.HasWhatsApp == true;
            var hasTG = d != null && d.HasTelegram == true;
            var statusUnknown = d == null || (d.HasWhatsApp == null && d.HasTelegram == null);
            <tr>
                <td>@c.Id</td>
                <td>@c.Name</td>
                <td class="phone">@LocalDisplay(c.Number)</td>
                <td><span class="bool-pill @BoolClass(d?.HasWhatsApp)">@BoolText(d?.HasWhatsApp)</span></td>
                <td><span class="bool-pill @BoolClass(d?.HasTelegram)">@BoolText(d?.HasTelegram)</span></td>
                <td class="actions">
                    @if (hasWA)
                    {
                        <a href="https://wa.me/@c.Number" target="_blank" class="btn btn-wa" title="WhatsApp">
                            <svg viewBox="0 0 24 24" width="18" height="18"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" fill="#fff"/></svg>
                        </a>
                    }
                    @if (hasTG)
                    {
                        <a href="tg://resolve?phone=@c.Number" class="btn btn-tg" title="Telegram">
                            <svg viewBox="0 0 24 24" width="18" height="18"><path d="M9.78 18.65l.28-4.23 7.68-6.92c.34-.31-.07-.46-.52-.19L7.74 13.3 3.64 12c-.88-.25-.89-.86.2-1.3l15.97-6.16c.73-.33 1.43.18 1.15 1.3l-2.72 12.81c-.19.91-.74 1.13-1.5.71L12.6 16.3l-1.99 1.93c-.23.23-.42.42-.83.42z" fill="#fff"/></svg>
                        </a>
                    }
                    <a href="tel:@c.Number" class="btn btn-call" title="Call">
                        <svg viewBox="0 0 24 24" width="18" height="18"><path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56-.35-.12-.74-.03-1.01.24l-1.57 1.97c-2.83-1.35-5.48-3.9-6.89-6.83l1.95-1.66c.27-.28.35-.67.24-1.02-.37-1.11-.56-2.3-.56-3.53 0-.54-.45-.99-.99-.99H4.19C3.65 3 3 3.24 3 3.99 3 13.28 10.73 21 20.01 21c.71 0 .99-.63.99-1.18v-3.45c0-.54-.45-.99-.99-.99z" fill="#fff"/></svg>
                    </a>
                    @if (statusUnknown)
                    {
                        <span class="status-pill status-pending" title="Detection in progress — refresh in a moment">…</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@functions {
    string PageHref(int p, int pageSize, string query)
    {
        var qs = $"?page={p}&pageSize={pageSize}";
        if (!string.IsNullOrEmpty(query)) qs += "&q=" + Uri.EscapeDataString(query);
        return qs;
    }
}

@if (totalPages > 1)
{
    <nav class="pagination">
        @if (currentPage > 1)
        {
            <a href="@PageHref(currentPage - 1, currentPageSize, query)">← Prev</a>
        }
        <span class="muted">Page @currentPage of @totalPages</span>
        @if (currentPage < totalPages)
        {
            <a href="@PageHref(currentPage + 1, currentPageSize, query)">Next →</a>
        }
    </nav>
}

<div class="legend">
    <strong>Legend:</strong>
    <span class="legend-item"><span class="dot dot-wa"></span> WhatsApp registered</span>
    <span class="legend-item"><span class="dot dot-tg"></span> Telegram registered</span>
    <span class="legend-item"><span class="dot dot-call"></span> Cellular call (always)</span>
    <span class="legend-item"><span class="status-pill status-pending">…</span> Detection pending</span>
</div>
