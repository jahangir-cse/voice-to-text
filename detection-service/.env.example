# Server
PORT=4000
NODE_ENV=production
LOG_LEVEL=info

# Database
DB_PATH=./data/numbers.db

# Telegram (get from https://my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcd1234efgh5678ijkl9012mnop

# Account pool sizes
WHATSAPP_POOL_SIZE=5
TELEGRAM_POOL_SIZE=2

# Daily quotas per account (anti-ban heuristic)
WHATSAPP_DAILY_LIMIT=1000
TELEGRAM_DAILY_LIMIT=10000

# Cache TTL for re-checking (days)
CACHE_TTL_DAYS=30

# Detection worker poll interval (seconds)
QUEUE_POLL_INTERVAL=30

# Rate limiting per API key
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_BURST_PER_SECOND=20

# Batch endpoint max size
BATCH_MAX_SIZE=100
